#include "win.hpp"
#include "res.h"

IDI_APP_ICON ICON "app_icon.ico"

IDR_MAIN_MENU MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&New\tCtrl+N",           IDM_FILE_NEW
        MENUITEM "&Open...\tCtrl+O",       IDM_FILE_OPEN
        MENUITEM "&Save\tCtrl+S",          IDM_FILE_SAVE
        MENUITEM "Save &As...\tCtrl+Shift+S", IDM_FILE_SAVE_AS
        MENUITEM SEPARATOR
        MENUITEM "E&xit",                  IDM_FILE_EXIT
    END
    POPUP "&Edit"
    BEGIN
        MENUITEM "&Undo\tCtrl+Z",          IDM_EDIT_UNDO
        MENUITEM "&Redo\tCtrl+Y",          IDM_EDIT_REDO
        MENUITEM SEPARATOR
        MENUITEM "Cu&t\tCtrl+X",           IDM_EDIT_CUT
        MENUITEM "&Copy\tCtrl+C",          IDM_EDIT_COPY
        MENUITEM "&Paste\tCtrl+V",         IDM_EDIT_PASTE
        MENUITEM "&Delete\tDel",           IDM_EDIT_DELETE
        MENUITEM SEPARATOR
        MENUITEM "&Find...\tCtrl+F",       IDM_EDIT_FIND
        MENUITEM "Find &Next\tF3",         IDM_EDIT_FIND_NEXT
        MENUITEM "&Replace...\tCtrl+H",    IDM_EDIT_REPLACE
        MENUITEM "&Go To...\tCtrl+G",      IDM_EDIT_GOTO
        MENUITEM "Time/&Date\tF5",         IDM_EDIT_TIME_DATE
        MENUITEM SEPARATOR
        MENUITEM "Select &All\tCtrl+A",    IDM_EDIT_SELECT_ALL
    END
    POPUP "F&ormat"
    BEGIN
        MENUITEM "&Font...",               IDM_FORMAT_FONT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Schwing Edit",    IDM_HELP_ABOUT
    END
END

IDD_GOTO DIALOGEX 0, 0, 160, 60
STYLE DS_MODALFRAME | DS_SETFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Go To Line"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Line number:", IDC_GOTO_LABEL, 8, 10, 60, 10
    EDITTEXT        IDC_GOTO_EDIT, 70, 8, 82, 14, ES_AUTOHSCROLL | ES_NUMBER
    DEFPUSHBUTTON   "Go To", IDOK, 38, 36, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 100, 36, 50, 14
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,0
 PRODUCTVERSION @VERSION_MAJOR@,@VERSION_MINOR@,@VERSION_PATCH@,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "Tian Liao"
            VALUE "FileDescription",  "Schwing Edit - High-performance text editor"
            VALUE "FileVersion",      "@PROJECT_VERSION@"
            VALUE "ProductName",      "Schwing Edit"
            VALUE "ProductVersion",   "@PROJECT_VERSION@"
            VALUE "OriginalFilename", "SchwingEdit.exe"
            VALUE "LegalCopyright",   "© 2026 Tian Liao"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
